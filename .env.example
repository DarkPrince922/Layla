# =====================================================================
# Layla — environment configuration (copy to .env and fill in)
# Secrets must NEVER be committed. .env is gitignored.
# =====================================================================

# ---- General ----
LAYLA_ENV=dev                      # dev | prod
LAYLA_PUBLIC_HOST=localhost        # public hostname served by Caddy in prod

# ---- Backend (layla-core) ----
# App-level encryption key for secrets-at-rest (Fernet, urlsafe base64, 32 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LAYLA_SECRET_KEY=CHANGE_ME_generate_a_fernet_key

# JWT signing secret (session cookies). Generate with: openssl rand -hex 32
LAYLA_JWT_SECRET=CHANGE_ME_random_hex_64
LAYLA_JWT_TTL_MINUTES=1440

# ---- Database ----
POSTGRES_USER=layla
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=layla
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Assembled by core from the parts above; override to point elsewhere.
DATABASE_URL=postgresql+asyncpg://layla:CHANGE_ME_postgres_password@postgres:5432/layla

# ---- Redis (agent state / pub-sub for live logs / queues) ----
REDIS_URL=redis://redis:6379/0

# ---- LiteLLM proxy (provider aggregation) ----
# The chat backend talks ONLY to LiteLLM, never to providers directly.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=CHANGE_ME_litellm_master_key   # sk-... style master key

# ---- Frontend (layla-frontend) ----
NEXT_PUBLIC_API_BASE=/api          # frontend calls core through Caddy at /api
