# =====================================================================
# Layla — environment configuration (copy to .env and fill in)
# Secrets must NEVER be committed. .env is gitignored.
# =====================================================================

# ---- General ----
LAYLA_ENV=dev                      # dev | prod
LAYLA_PUBLIC_HOST=localhost        # имя хоста для приложения (метаданные, cookie)

# Адрес, который слушает Caddy. Определяет HTTP vs HTTPS:
#   HTTP  (dev):  http://localhost | http://<IP> | http://<домен> | :80
#                 — простой HTTP, БЕЗ авто-TLS и БЕЗ редиректа на https.
#   HTTPS (prod): голый домен example.com — Caddy сам получит сертификат.
# Если сайт «уходит» на https, а нужен http — впишите префикс http:// сюда.
LAYLA_SITE_ADDRESS=http://localhost

# ---- Учётные записи ----
# При первой установке (когда пользователей ещё нет) создаётся администратор
# с этим e-mail и случайным паролем — пароль показывается в окне входа один раз
# (и пишется в логи контейнера). Замените на свой реальный e-mail.
LAYLA_ADMIN_EMAIL=admin@layla.app
# Открытая саморегистрация. По умолчанию ВЫКЛ: пользователей заводит админ
# (Настройки → Пользователи). Поставьте true, чтобы разрешить всем регистрацию.
LAYLA_ALLOW_OPEN_REGISTRATION=false

# ---- Backend (layla-core) ----
# App-level encryption key for secrets-at-rest (Fernet, urlsafe base64, 32 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LAYLA_SECRET_KEY=CHANGE_ME_generate_a_fernet_key

# JWT signing secret (session cookies). Generate with: openssl rand -hex 32
LAYLA_JWT_SECRET=CHANGE_ME_random_hex_64
LAYLA_JWT_TTL_MINUTES=1440

# ---- Database ----
POSTGRES_USER=layla
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=layla
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL собирается ядром из POSTGRES_* выше (пароль URL-кодируется),
# поэтому менять пароль достаточно в одном месте. Раскомментируйте только если
# нужно указать ВНЕШНЮЮ БД целиком:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ---- Redis (agent state / pub-sub for live logs / queues) ----
REDIS_URL=redis://redis:6379/0

# ---- LiteLLM proxy (provider aggregation) ----
# The chat backend talks ONLY to LiteLLM, never to providers directly.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=CHANGE_ME_litellm_master_key   # sk-... style master key

# ---- Frontend (layla-frontend) ----
NEXT_PUBLIC_API_BASE=/api          # frontend calls core through Caddy at /api

# ---- Запуск кода (песочница проекта и Piston) ----
# Песочница: команды агента и терминала в копии проекта (pip/npm install, тесты, сборка).
# Всегда есть Python 3.12, Node.js 22, gcc/g++/make. Дополнительные языки — флагами сборки
# (после изменения: docker compose build sandbox):
SANDBOX_WITH_GO=false
SANDBOX_WITH_RUST=false
SANDBOX_WITH_JAVA=false
# Ресурсы контейнера песочницы (на всех пользователей сразу).
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
# Предел одной команды, секунд.
SANDBOX_MAX_TIMEOUT=900
# Интернет из песочницы идёт только через прокси и только к реестрам пакетов (PyPI, npm,
# Go, crates.io, Maven). Добавить хосты — через запятую (поддомены тоже подходят),
# «*» — любые публичные адреса. Локальная сеть и метаданные облака закрыты всегда.
SANDBOX_ALLOW_HOSTS=
# Piston (запуск программ на других языках): пределы в миллисекундах и байтах.
PISTON_RUN_TIMEOUT=15000
PISTON_COMPILE_TIMEOUT=60000
PISTON_RUN_MEMORY_LIMIT=536870912
